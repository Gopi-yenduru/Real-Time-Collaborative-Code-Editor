# ===========================================================================
# Backend environment (Spring Boot). Copy to `.env` or export before running.
# All values have sensible local-dev defaults in application.properties.
# ===========================================================================

# --- Server ---
SERVER_PORT=8080

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=code_editor
DB_USERNAME=root
DB_PASSWORD=

# --- Redis (used to relay collaboration across nodes) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ---
# Use a long random string (>= 32 chars) or a Base64-encoded 256-bit key.
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRATION=86400000

# --- CORS (comma-separated origins allowed to call the API + WebSocket) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
