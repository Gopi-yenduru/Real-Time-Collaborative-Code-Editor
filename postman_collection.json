{
	"info": {
		"_postman_id": "a931a28a-7c93-41bb-b5fb-39b0d1e37bc9",
		"name": "Real-Time Collaborative Code Editor",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Register",
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"testuser1\",\n    \"email\": \"test1@example.com\",\n    \"password\": \"password\"\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/auth/register",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "auth", "register"]
				}
			}
		},
		{
			"name": "2. Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"pm.environment.set(\"jwt_token\", jsonData.token);",
							"pm.environment.set(\"user_id\", jsonData.user.id);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"testuser1\",\n    \"password\": \"password\"\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/auth/login",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "auth", "login"]
				}
			}
		},
		{
			"name": "3. Current User (me)",
			"request": {
				"method": "GET",
				"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
				"url": {
					"raw": "http://localhost:8080/api/auth/me",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "auth", "me"]
				}
			}
		},
		{
			"name": "4. Create Document",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"pm.environment.set(\"doc_id\", jsonData.id);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"title\": \"My First File\",\n    \"language\": \"java\"\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/documents",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "documents"]
				}
			}
		},
		{
			"name": "5. List Documents",
			"request": {
				"method": "GET",
				"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
				"url": {
					"raw": "http://localhost:8080/api/documents",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "documents"]
				}
			}
		},
		{
			"name": "6. Get Document",
			"request": {
				"method": "GET",
				"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
				"url": {
					"raw": "http://localhost:8080/api/documents/{{doc_id}}",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "documents", "{{doc_id}}"]
				}
			}
		},
		{
			"name": "7. Update Content (mirror)",
			"request": {
				"method": "PUT",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"content\": \"System.out.println(\\\"hello\\\");\"\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/documents/{{doc_id}}/content",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "documents", "{{doc_id}}", "content"]
				}
			}
		},
		{
			"name": "8. Share Document",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"test2@example.com\",\n    \"role\": \"EDITOR\"\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/documents/{{doc_id}}/share",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "documents", "{{doc_id}}", "share"]
				}
			}
		},
		{
			"name": "9. List Versions (snapshots)",
			"request": {
				"method": "GET",
				"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
				"url": {
					"raw": "http://localhost:8080/api/documents/{{doc_id}}/snapshots?page=0&size=20",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "documents", "{{doc_id}}", "snapshots"],
					"query": [
						{ "key": "page", "value": "0" },
						{ "key": "size", "value": "20" }
					]
				}
			}
		},
		{
			"name": "10. Create Version (snapshot)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"pm.environment.set(\"snapshot_id\", jsonData.id);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"label\": \"Checkpoint\",\n    \"state\": \"AAA=\",\n    \"content\": \"snapshot text\"\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/documents/{{doc_id}}/snapshots",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "documents", "{{doc_id}}", "snapshots"]
				}
			}
		},
		{
			"name": "11. Restore Version",
			"request": {
				"method": "POST",
				"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
				"url": {
					"raw": "http://localhost:8080/api/documents/{{doc_id}}/snapshots/{{snapshot_id}}/restore",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "documents", "{{doc_id}}", "snapshots", "{{snapshot_id}}", "restore"]
				}
			}
		}
	]
}
